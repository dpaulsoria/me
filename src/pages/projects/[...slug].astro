---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { ProjectEntry } from "../../types/content"

const { project } = Astro.props as { project: ProjectEntry };

const base = import.meta.env.BASE_URL
export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { Content } = await project.render();
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a class="underline text-sm" href=`${base}/projects`>← Back to Projects</a>

    <h1 class="mt-4 text-3xl font-bold">{project.data.title}</h1>
    <p class="mt-3 text-gray-600">{project.data.description}</p>

    {project.data.stack?.length ? (
      <div class="mt-4 flex flex-wrap gap-2">
        {project.data.stack.map((t) => (
          <span class="rounded-full border px-3 py-1 text-sm text-gray-600">
            {t}
          </span>
        ))}
      </div>
    ) : null}

    <div class="mt-6 flex gap-4">
      {project.data.url ? <a class="underline" href={project.data.url} target="_blank">Live</a> : null}
      {project.data.repo ? <a class="underline" href={project.data.repo} target="_blank">Repo</a> : null}
    </div>

    <article class="prose prose-neutral mt-10 max-w-none">
      <Content />
    </article>
  </main>
</Layout>
