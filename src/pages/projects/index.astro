---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { ProjectEntry } from "../../types/content"

const base = import.meta.env.BASE_URL
const projects: ProjectEntry[] = await getCollection("projects");
projects.sort((a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999));
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold">Projects</h1>

    <div class="mt-8 grid gap-4">
      {
        projects.map((p) => (
          <article class="rounded-xl border p-5">
            <h2 class="text-xl font-semibold">{p.data.title}</h2>
            <p class="mt-2 text-gray-600">{p.data.description}</p>
            <p class="mt-3 text-sm text-gray-500">{p.data.stack.join(", ")}</p>
            <a
              class="mt-4 inline-block underline"
              href={`${base}/projects/${p.slug}/`}
            >
              View
            </a>
          </article>
        ))
      }
    </div>
  </main>
</Layout>