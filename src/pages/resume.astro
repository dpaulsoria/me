---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold pb-4">Resume</h1>
    <a class="btn" href="/cv.pdf" target="_blank">Open CV</a>
    <a class="btn" href="/cv.pdf" download>Download CV</a>

    <div class="mt-6 hidden md:block">
      <iframe
        class="h-[900px] w-full rounded-xl border"
        src="/cv.pdf"></iframe>
    </div>
  </main>
</Layout>
